# AI vs Human Doctor – Smart Healthcare Comparison Platform
# Environment Configuration Example

# Database (PostgreSQL in production, SQLite fallback in local dev if omitted)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/ai_vs_human_doctor

# Security / JWT
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional External LLM Integration (falls back to built-in Scikit-learn Clinical Decision-Support Demo Mode)
LLM_API_KEY=
LLM_MODEL=

# File Storage
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=15

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
